{
  "manifest_version": 3,
  "name": "Glypt — Icons & Brand Kits",
  "short_name": "Glypt",
  "description": "Extract brand palettes from any site, jump into your asset dashboard, and reach 200k+ icons.",
  "version": "0.1.0",
  "permissions": ["contextMenus", "storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Glypt" }
}
