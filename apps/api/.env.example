# Glypt API environment.
# Copy to .env.local for local runs; set these in the Render dashboard for production.

# Postgres connection string. Without it the API runs read-only (no auth/collections).
# Render Postgres: created by the render.yaml blueprint, or paste your own.
DATABASE_URL=

# Comma-separated browser origins allowed to call the API (your Vercel site).
# Example: https://glypt.vercel.app
WEB_ORIGIN=

# Port the API listens on. Render injects PORT at runtime; point API_PORT at it
# (render.yaml sets API_PORT=${PORT} via the start command). Locally 4000 is fine.
API_PORT=4000