# PostgreSQL (required for accounts, favorites, collections, shares)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/glypt

# API server
API_PORT=4000
NODE_ENV=development

# CORS allowlist for browser clients (comma-separated)
WEB_ORIGIN=http://localhost:5173,http://localhost:4173

# Public API key for /api/v1/* endpoints (leave empty to disable)
ADMIN_TOKEN=

# Canonical app URL
APP_URL=http://localhost:4173
